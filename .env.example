# ── Base de datos (PostgreSQL / Supabase) ───────────────────────────────────
# Local dev: valores por defecto sirven para `docker compose up -d`.
# Producción: reemplazar por la connection string del proyecto de Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=turnify
DB_PASSWORD=turnify
DB_NAME=turnify
# Si se define, tiene prioridad sobre los campos individuales de arriba
# (formato que entrega Supabase: postgresql://user:pass@host:port/db)
DATABASE_URL=

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Auth (JWT) ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Frontend (Vite solo expone al navegador las variables VITE_*) ──────────
VITE_API_URL=http://localhost:3000

# ── Notificaciones (fase posterior al Seguimiento #2) ───────────────────
# Sin dominio verificado en Resend, el remitente debe ser onboarding@resend.dev
# (solo puede enviar a la dirección dueña de la cuenta).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Meta WhatsApp Cloud API (no Twilio): https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Pagos (fase posterior al Seguimiento #2) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Chatbot / LLM (fase posterior al Seguimiento #2) ────────────────────
LLM_API_KEY=
